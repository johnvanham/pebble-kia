# Single shared bearer token. Generate with `openssl rand -hex 32`. Required.
PROXY_BEARER_TOKEN=

# Address the proxy container binds on. Loopback by default, because the
# intended setup reverse-proxies it through Caddy. Set to 0.0.0.0 to test
# straight from a phone on the LAN — no TLS, so the token is in clear.
PROXY_BIND=127.0.0.1

# demo | live.
DATA_SOURCE=demo

# Path (relative to the process cwd) of the demo JSON file. Re-read on every
# fetch so edits surface on the next forced refresh.
DEMO_DATA_FILE=demo-data.json

# Minimum seconds between live pulls per vehicle. Cached responses are served
# while fresher than this. These pulls read Kia's server-side cache and do
# not wake the vehicle.
LIVE_REFRESH_MIN_SECONDS=600

# Floor on car-waking refreshes (force=1 / POST /refresh). Those call Kia's
# force-refresh, which wakes the telematics unit and draws on the 12V
# battery, so they are throttled harder than ordinary reads. A forced
# refresh inside this window is quietly downgraded to a cached read rather
# than rejected, and the response carries forced=false to say so.
LIVE_FORCE_MIN_SECONDS=900

# Same knob but for the demo source. Kept short so scenario progression
# surfaces to the watch without needing a long-press refresh every tick.
DEMO_REFRESH_MIN_SECONDS=5

# Background transition detector poll interval. Leave unset to get the
# per-source default: 20s for demo (so scenario progression is visible),
# 300s for live. The detector shares the status cache with the watch, so
# one interval is one upstream call per vehicle.
#DETECTOR_INTERVAL_SECONDS=

# Kia account. Only read when DATA_SOURCE=live. EU logs in with plain
# username/password — no browser bootstrap, no token capture. Leave the PIN
# empty unless your account has one (CA/US do, EU normally does not).
KIA_USERNAME=
# Wrap the password in SINGLE quotes if it contains a '$' or a '#'.
# docker compose reads this file for its own interpolation and treats
# $NAME as a variable reference, so an unquoted '$' silently truncates
# the password and Kia then rejects a login you know is correct. Single
# quotes are literal to both compose and pydantic-settings, so quoting
# is always safe: KIA_PASSWORD='p4ss$word#1'
KIA_PASSWORD=
KIA_PIN=
# 1=Europe, 2=Canada, 3=USA, 4=China, 5=Australia
KIA_REGION=1
# 1=Kia, 2=Hyundai, 3=Genesis
KIA_BRAND=1
KIA_LANGUAGE=en

# SQLite file holding the Kia refresh token and last-known vehicle state, so
# a restart doesn't cost the watch a cold fetch. Under docker compose this
# lives on the proxy-state volume.
PROXY_STATE_DB=state.db

# ntfy push target. Leave NTFY_URL empty to disable push — transitions
# are still detected and logged, but nothing is sent anywhere. Set both
# URL and TOPIC to enable. Topic is a guess-hard string chosen by you;
# don't rely on it for auth on public ntfy.sh.
NTFY_URL=
NTFY_TOPIC=
# Only needed for self-hosted ntfy running with auth enabled.
NTFY_AUTH_TOKEN=

# Public-facing URL for the self-hosted ntfy (used by the phone app to
# subscribe). Only relevant when running via docker compose — the
# proxy itself reaches ntfy directly over the compose network.
NTFY_PUBLIC_URL=https://ntfy.example.com

# Directory the setup QR images are written to at startup, so the bearer
# token can be scanned with the phone camera instead of typed into Clay.
# The files hold a live credential: they are created owner-only and are
# never served over HTTP. Defaults to `setup/` inside this proxy
# directory, wherever the process happens to be started from — set an
# absolute path to move it, or leave it empty to switch the feature off.
# Compose overrides it to /app/setup, bind-mounted to ./setup on the host.
#SETUP_QR_DIR=

# Also print the token QR into the startup log. Off by default, and think
# before turning it on: the log block is a machine-decodable copy of the
# bearer token, so anything that keeps logs — the container log driver
# across a token rotation, a log shipper, a pasted `docker compose logs`
# — is keeping the credential. It exists for headless hosts where the log
# is the only way to get at the QR. Rotate the token if a log escapes.
#SETUP_QR_LOG=1

# The base URL the *phone* should use to reach this proxy — normally the
# public Caddy hostname. The proxy has no way to know its own
# externally-reachable address, so leave this empty and no URL QR is
# written rather than one encoding a guess.
PROXY_PUBLIC_URL=

# Level for the proxy's own loggers only. Third-party loggers stay at
# WARNING deliberately: hyundai_kia_connect_api at DEBUG prints whole Kia
# payloads, VIN and GPS included. uvicorn's request log is separate and
# unaffected. An unrecognised value falls back to info.
LOG_LEVEL=info
