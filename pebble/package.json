{
  "name": "pebble-kia",
  "author": "John Van Ham",
  "version": "0.1.0",
  "description": "Kia vehicle stats on your Pebble: charge, range, doors and charging status via a self-hosted Kia Connect proxy.",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {
    "pebble-clay": "^1.0.4"
  },
  "pebble": {
    "displayName": "Kia",
    "uuid": "5b7e9a12-3c4d-4e8f-9a1b-2c3d4e5f6a7b",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "basalt",
      "diorite",
      "chalk"
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "REQ_KIND",
      "REQ_ID",
      "RESP_KIND",
      "VEHICLE_COUNT",
      "VEHICLE_ID[4]",
      "VEHICLE_NICK[4]",
      "STATUS_ID",
      "SOC_PCT",
      "RANGE_KM",
      "IS_CHARGING",
      "CHARGE_KW_X10",
      "CHARGE_ETA_MIN",
      "PLUG",
      "DOORS_LOCKED",
      "OUTSIDE_TEMP_C",
      "ODO_KM",
      "IS_CLIMATE_ON",
      "UPDATED_AT",
      "UNIT_MILES",
      "ERROR_MSG",
      "AUX_BATTERY_PCT",
      "CHARGE_LIM_AC",
      "CHARGE_LIM_DC",
      "DOORS_OPEN",
      "WINDOWS_OPEN",
      "TRUNK_OPEN",
      "HOOD_OPEN",
      "SUNROOF_OPEN",
      "EFF_KMPKWH_X10",
      "BATT_TEMP_C",
      "ACTION",
      "ACTION_AC",
      "ACTION_DC",
      "FORCED",
      "DEFROST_ON",
      "REAR_DEFROST_ON",
      "WHEEL_HEAT_ON",
      "BATT_COND",
      "V2L_LIMIT_PCT",
      "V2L_KW_X10",
      "TGT_RANGE_AC_KM",
      "TGT_RANGE_DC_KM"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "IMAGE_MENU_ICON",
          "file": "images/menu_icon.png",
          "menuIcon": true
        }
      ]
    },
    "capabilities": [
      "configurable"
    ]
  }
}
